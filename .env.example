# === DATABASE (Supabase PostgreSQL) ===
# Lấy từ Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=
# Direct connection dùng cho Prisma migrate
DIRECT_URL=

# === SUPABASE — public (được phép dùng ở browser) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === SUPABASE — private (CHỈ dùng ở server, KHÔNG thêm NEXT_PUBLIC_) ===
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# === ADMIN SESSION ===
# Mật khẩu đăng nhập admin tại /admin/login
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 ký tự để ký JWT session (openssl rand -base64 32)
ADMIN_SESSION_SECRET=
